#!/bin/bash

if [ "$#" -ne 3 ]; then
    echo "Penggunaan: addssh <username> <password> <hari>"
    exit 1
fi

USERNAME=$1
PASSWORD=$2
DAYS=$3

# Menghitung tanggal kadaluarsa (YYYY-MM-DD)
EXP_DATE=$(date -d "+${DAYS} days" +"%Y-%m-%d")

# Memeriksa apakah user sudah ada
if id "$USERNAME" &>/dev/null; then
    echo "Error: User '$USERNAME' sudah ada!"
    exit 1
fi

# Membuat user baru dengan shell /bin/false, tanpa direktori home (-M), dan tanggal kadaluarsa
useradd -e "$EXP_DATE" -s /bin/false -M "$USERNAME"

if [ $? -eq 0 ]; then
    # Mengatur password
    echo "$USERNAME:$PASSWORD" | chpasswd
    echo "======================================"
    echo "Berhasil membuat SSH Account"
    echo "Username   : $USERNAME"
    echo "Password   : $PASSWORD"
    echo "Masa aktif : $DAYS hari"
    echo "Kadaluarsa : $EXP_DATE"
    echo "======================================"
else
    echo "Error: Gagal membuat user '$USERNAME'."
    exit 1
fi
